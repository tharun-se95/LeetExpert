# Local Ollama daemon (gemma4 cloud, proxied through `ollama signin`).
# Restart `npm run dev` after changing this.
COACH_PROVIDER=ollama
COACH_MODEL=gemma4:cloud
OLLAMA_HOST=http://127.0.0.1:11434

# Or Ollama Cloud directly — no local daemon, no tunnel, works the same in
# prod as in dev. Create a key at ollama.com/settings/keys. OLLAMA_HOST is
# left unset here on purpose: an API key with no host defaults to
# https://ollama.com, since gemma4:cloud already runs on Ollama's own
# infrastructure rather than the caller's.
# COACH_PROVIDER=ollama
# COACH_MODEL=gemma4:cloud
# OLLAMA_API_KEY=

# Or a hosted key instead of Ollama:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COACH_MODEL=claude-sonnet-4-6

# Production chat also needs Redis. Dev uses in-memory quota.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# COACH_DAILY_CAP=40
# COACH_QUOTA=memory

# Accounts (spec 2026-09-18). All seven must be set or sign-in stays off.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: enables POST /api/test-login for browser tests. 404 in production builds.
AUTH_TEST_LOGIN=
