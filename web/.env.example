# Local Ollama (gemma4 cloud). Restart `npm run dev` after changing this.
COACH_PROVIDER=ollama
COACH_MODEL=gemma4:cloud
OLLAMA_HOST=http://127.0.0.1:11434

# Or a hosted key instead of Ollama:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COACH_MODEL=claude-sonnet-4-6

# Production chat also needs Redis. Dev uses in-memory quota.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# COACH_DAILY_CAP=40
# COACH_QUOTA=memory
